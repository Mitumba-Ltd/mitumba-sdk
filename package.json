{
  "name": "@mitumba/sdk",
  "version": "1.31.0",
  "description": "The official TypeScript SDK for the Mitumba marketplace platform.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:client-lifecycle:coverage": "vitest run src/client.test.ts --coverage --coverage.include=src/client.ts --coverage.thresholds.branches=75 --coverage.thresholds.functions=80 --coverage.thresholds.lines=85 --coverage.thresholds.statements=85",
    "test:messages:coverage": "vitest run src/modules/messages.test.ts src/modules/messages-v2.test.ts src/realtime/messages-realtime.test.ts src/types/messages-v2.test.ts --coverage --coverage.include=src/modules/messages.ts --coverage.include=src/realtime/messages-realtime.ts --coverage.include=src/types/messages-v2.ts --coverage.thresholds.branches=85 --coverage.thresholds.functions=100 --coverage.thresholds.lines=95 --coverage.thresholds.statements=95",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ --ext .ts",
    "prepare": "npm run build",
    "release": "changeset publish"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Mitumba-Ltd/mitumba-sdk"
  },
  "author": "Mitumba Ltd",
  "license": "MIT",
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.12.7",
    "@vitest/coverage-v8": "^1.6.1",
    "eslint": "^10.10.0",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.69.0",
    "vitest": "^1.6.0"
  }
}
